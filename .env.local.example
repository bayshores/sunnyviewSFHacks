# Copy to .env.local and fill in what you need. Every variable is optional for
# local development: without a key, the matching feature falls back or is disabled.
# Never commit real values. Keep secrets server-side (no NEXT_PUBLIC_ prefix)
# unless the variable is explicitly public.

# ---------------------------------------------------------------------------
# Live features (server-side secrets)
# ---------------------------------------------------------------------------

# NREL PVWatts key for POST /api/estimate. Without it, estimates use built-in defaults.
# PVWATTS_API_KEY=your-nrel-pvwatts-api-key

# Google Gemini key for POST /api/panel-recommend and /api/gemini-validate.
# Clients may also send their own key in the x-gemini-api-key header.
# GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs key and default voice for POST /api/tts. Without a key, TTS is disabled.
# Clients may also send their own key in the x-elevenlabs-api-key header.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id

# MongoDB connection for History (/api/history), Projects (/api/projects) and
# Share (/api/share/[slug]). Without it these routes respond with 503.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# MONGODB_DB=sunnyview

# ---------------------------------------------------------------------------
# Optional: infrastructure and tuning
# ---------------------------------------------------------------------------

# Upstash Redis REST endpoint for caching PVWatts estimates (24h). Both must be set.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# External CV segmentation service used by POST /api/segment. If unset outside
# production, the route probes http://127.0.0.1:8000 and http://localhost:8000
# (/healthz). Without a reachable service it uses the in-app fallback. The Python
# service's own variables (SAM_*, ROOFSEG_*) are documented in services/segmenter/README.md.
# SEGMENT_SERVICE_URL=http://localhost:8000

# Optional shared secret. When set, the Next route sends it as x-segment-secret to
# the Python segmenter, which must be started with the same value. Server-only.
# SEGMENT_SHARED_SECRET=change-me

# Comma-separated hostnames that POST /api/segment may fetch images from, in
# addition to the app's own host. Private and loopback hosts are always blocked.
# SEGMENT_IMAGE_FETCH_ALLOWLIST=example-cdn.com

# Public origin of this app. Same-origin image paths (for example /api/static-map)
# sent to POST /api/segment are resolved against it; the request Host header is
# never trusted. Defaults to https://$VERCEL_URL on Vercel, else http://127.0.0.1:$PORT
# in development only. In production (NODE_ENV=production) off Vercel you MUST set
# APP_ORIGIN, otherwise relative image paths are rejected and the address flow's
# /api/static-map image cannot reach an external segmenter (only allowlisted public
# https URLs are accepted).
# APP_ORIGIN=https://sunnyview.example.com

# Which header carries the real client IP for rate limiting. On Vercel this
# defaults to x-vercel-forwarded-for. Elsewhere, unset means every client shares
# one bucket. Use x-real-ip, or x-forwarded-for (right-most entry is used), but
# only behind a proxy that overwrites it.
# TRUSTED_PROXY_HEADER=x-real-ip

# Global (not per-IP) daily request budgets for usage billed to SERVER-side keys
# (client-supplied keys are not counted). In-memory per instance, reset 00:00 UTC.
# TTS_DAILY_BUDGET=500
# GEMINI_DAILY_BUDGET=1000

# Pinned ElevenLabs model for /api/tts (clients cannot choose it).
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Override the CO2 factor in kg per kWh (clamped to 0.05 to 2). Default lives in lib/solar-defaults.ts.
# CO2_KG_PER_KWH=0.4

# Maximum saved history entries per visitor (default 100, hard cap 300).
# HISTORY_RETENTION_MAX=100

# Saved projects (Share) expire this many days after their last update (TTL index,
# default 90, clamped 1-3650). Changing it later needs a MongoDB collMod on the index.
# PROJECTS_TTL_DAYS=90

# Maximum projects kept per visitor; oldest are deleted beyond this (default 50, 1-1000).
# PROJECTS_MAX_PER_VISITOR=50

# Anonymous visitor cookie used to scope History and Projects.
# HISTORY_COOKIE_NAME=sv_vid
# HISTORY_COOKIE_MAX_AGE_DAYS=365

# ---------------------------------------------------------------------------
# Optional: client-side (NEXT_PUBLIC_ values are inlined at build time)
# ---------------------------------------------------------------------------

# Point the browser at another backend origin for /api/* calls (for example a
# separate deployment). Leave unset to use same-origin routes. Note: History and
# Projects/Share rely on a same-origin visitor cookie and reject cross-site writes,
# so they only work against a same-origin backend.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# Cesium ion token for the 3D globe.
# NEXT_PUBLIC_CESIUM_ION_TOKEN=your-cesium-ion-token

# Mapbox token. Used only as the fallback provider for GET /api/static-map,
# tried after ArcGIS imagery fails.
# NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-public-token

# ---------------------------------------------------------------------------
# Local tooling only (read by structurizr/export-diagrams.mjs, not by the app)
# ---------------------------------------------------------------------------

# Browser used to render the Structurizr PNGs. Defaults to the first installed
# Chrome, Chromium, or Edge found in common locations.
# CHROME_BIN=/path/to/chrome
# DIAGRAM_WIDTH=1920
# DIAGRAM_HEIGHT=1080
# DIAGRAM_DPR=1
